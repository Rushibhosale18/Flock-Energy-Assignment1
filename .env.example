# ==============================================================================
# Flock Energy - Urja Meter Ops API Service Configuration
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Service Port
PORT=3001

# Upstream Legacy Urja Portal Configuration
PORTAL_URL=https://urja-ops.flockenergy.tech
URJA_EMAIL=operator@urja.local
URJA_PASSWORD=urja-ops-2026

# Upstream Request Timeout in Milliseconds
PORTAL_TIMEOUT_MS=15000

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info
