{
  "openapi": "3.0.0",
  "info": {
    "title": "Flock Energy - Urja Meter Ops API",
    "version": "1.0.0",
    "description": "\n## Enterprise REST API Wrapper for Urja Meter Ops\nThis service automates authentication against SvelteKit session endpoints, manages CSRF constraints, queries internal grid telemetry APIs, scrapes SSR Nameplate specifications via Cheerio, normalizes inconsistent data types into clean JSON, and exposes documented REST endpoints for downstream clients.\n\n### Key Capabilities\n- **Automated Session Lifecycle**: Automatic session establishment, 3600s TTL tracking, and auto-healing on HTTP 401/403.\n- **Dual-Stack DNS Resilience**: Fallback resolution for NAT64/IPv6 networks.\n- **Full Inventory Telemetry**: Real-time paginated access to all 403 smart meters across Jaipur's electrical grid.\n- **Clean Time-Series Coercion**: 30-minute interval readings normalized from string floats into native IEEE 754 numbers and ISO 8601 timestamps.\n- **Grid Network Topology**: Hierarchical aggregation of Zones, Circles, Divisions, Subdivisions, Substations, Feeders, and Distribution Transformers (DTs).\n        ",
    "contact": {
      "name": "Flock Energy Platform Engineering",
      "email": "engineering@flockenergy.tech"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://flockenergy.tech"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local Gateway"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Session management and portal authentication"
    },
    {
      "name": "Meters",
      "description": "Smart meter inventory, telemetry, and detailed diagnostics"
    },
    {
      "name": "Network Topology",
      "description": "Distribution transformer and electrical grid hierarchy"
    },
    {
      "name": "System",
      "description": "Health and service diagnostics"
    }
  ],
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "operator@urja.local"
          },
          "password": {
            "type": "string",
            "example": "urja-ops-2026"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "example": "authenticated"
              },
              "authenticated_at": {
                "type": "string",
                "format": "date-time"
              },
              "operator": {
                "type": "string",
                "example": "operator@urja.local"
              },
              "session_expires_in_seconds": {
                "type": "integer",
                "example": 3600
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "example": "c52d43e1-7e82-411a-bf41-6c4b6e5e9b88"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "MeterSummary": {
        "type": "object",
        "properties": {
          "meter_id": {
            "type": "string",
            "example": "J100000"
          },
          "serial_number": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phase_type": {
            "type": "string",
            "example": "single"
          },
          "install_status": {
            "type": "string",
            "example": "Decommissioned"
          },
          "install_type": {
            "type": "string",
            "example": "Whole Current",
            "nullable": true
          },
          "dt_code": {
            "type": "string",
            "example": "DT-001"
          }
        }
      },
      "MeterListResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "example": 403
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "page_size": {
            "type": "integer",
            "example": 20
          },
          "total_pages": {
            "type": "integer",
            "example": 21
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeterSummary"
            }
          }
        }
      },
      "GeoCoordinates": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "float",
            "example": 26.938961
          },
          "longitude": {
            "type": "number",
            "format": "float",
            "example": 75.830957
          }
        }
      },
      "MeterHierarchyBreadcrumb": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "example": "Jaipur Zone 1 (Z-01)"
          },
          "circle": {
            "type": "string",
            "example": "Circle 1 (C-01)"
          },
          "division": {
            "type": "string",
            "example": "Division 1 (D-01)"
          },
          "subdivision": {
            "type": "string",
            "example": "Subdivision 1 (SD-01)"
          },
          "substation": {
            "type": "string",
            "example": "Substation 1 (SS-01)"
          },
          "feeder": {
            "type": "string",
            "example": "Feeder 1 (F-001)"
          },
          "dt": {
            "type": "string",
            "example": "Malviya Nagar DT 1 (DT-001)"
          }
        }
      },
      "MeterDetail": {
        "type": "object",
        "properties": {
          "meter_id": {
            "type": "string",
            "example": "J100000"
          },
          "serial_number": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phase_type": {
            "type": "string",
            "example": "single"
          },
          "install_status": {
            "type": "string",
            "example": "Decommissioned"
          },
          "install_type": {
            "type": "string",
            "example": "Whole Current"
          },
          "dt_code": {
            "type": "string",
            "example": "DT-001"
          },
          "geo": {
            "$ref": "#/components/schemas/GeoCoordinates"
          },
          "hierarchy": {
            "$ref": "#/components/schemas/MeterHierarchyBreadcrumb"
          },
          "raw_attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ConsumptionReading": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-23T23:30:00Z"
          },
          "raw_timestamp": {
            "type": "string",
            "example": "23/06/2026 23:30"
          },
          "kwh": {
            "type": "number",
            "format": "float",
            "example": 48438.74
          },
          "kvah": {
            "type": "number",
            "format": "float",
            "example": 52313.84
          },
          "voltage_r": {
            "type": "number",
            "format": "float",
            "example": 226
          }
        }
      },
      "ConsumptionHistoryResponse": {
        "type": "object",
        "properties": {
          "meter_id": {
            "type": "string",
            "example": "J100000"
          },
          "total_readings": {
            "type": "integer",
            "example": 337
          },
          "time_window": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "latest_kwh": {
                "type": "number",
                "format": "float",
                "example": 48580.79
              },
              "latest_kvah": {
                "type": "number",
                "format": "float",
                "example": 52467.25
              },
              "latest_voltage_r": {
                "type": "number",
                "format": "float",
                "example": 220
              },
              "average_voltage_r": {
                "type": "number",
                "format": "float",
                "example": 229.83
              }
            }
          },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsumptionReading"
            }
          }
        }
      },
      "Transformer": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "DT-001"
          },
          "name": {
            "type": "string",
            "example": "Malviya Nagar DT 1"
          },
          "feeder_code": {
            "type": "string",
            "example": "F-001"
          },
          "capacity_kva": {
            "type": "number",
            "example": 100
          }
        }
      },
      "TransformerListResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "example": 40
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "page_size": {
            "type": "integer",
            "example": 20
          },
          "total_pages": {
            "type": "integer",
            "example": 2
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transformer"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "Meter J999999 was not found."
              },
              "details": {
                "type": "object",
                "nullable": true
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "example": "123e4567-e89b-12d3-a456-426614174000"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Comprehensive system health and upstream connectivity check",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy and connected to legacy Urja portal"
          }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "summary": "Retrieve distribution transformers in the grid",
        "tags": [
          "Network Topology"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number"
          }
        ],
        "responses": {
          "200": {
            "description": "List of distribution transformers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "summary": "Retrieve organized network hierarchy tree from Zone down to connected meters",
        "description": "Assembles the 7-tier electrical distribution network tree from live inventory and topology models.",
        "tags": [
          "Network Topology"
        ],
        "responses": {
          "200": {
            "description": "Full electrical grid hierarchy tree"
          }
        }
      }
    },
    "/api/v1/export": {
      "get": {
        "summary": "Bulk export all 403 meters via HMAC-SHA256 signed request",
        "description": "Utilizes the portal's cryptographic key derivation protocol to export complete grid models.",
        "tags": [
          "Meters"
        ],
        "responses": {
          "200": {
            "description": "Complete inventory of all meters with full topology and GPS coordinates"
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "summary": "Retrieve smart meters inventory with search and pagination",
        "description": "Fetches live meter records from the Urja portal with normalized field types and search filtering.",
        "tags": [
          "Meters"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "description": "Search query matching meter ID or serial number"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number (1-based)"
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Items per page"
          },
          {
            "in": "query",
            "name": "all",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "If true, returns all 403 meters at once via bulk signed export"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated meters inventory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{id}": {
      "get": {
        "summary": "Get detailed specifications, hierarchy, and geo coordinates for a meter",
        "description": "Scrapes SSR Nameplate specifications, retrieves GPS coordinates from internal geo service, and extracts electrical breadcrumbs.",
        "tags": [
          "Meters"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Meter identifier (e.g., J100000)"
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed meter record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            }
          },
          "404": {
            "description": "Meter ID not found"
          }
        }
      }
    },
    "/api/v1/meters/{id}/consumption": {
      "get": {
        "summary": "Retrieve historical energy consumption readings and analytics summary",
        "description": "Returns clean, chronological 30-minute interval readings with float conversions, ISO 8601 timestamps, and computed statistics.",
        "tags": [
          "Meters"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Meter identifier (e.g., J100000)"
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized consumption telemetry records and aggregate stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionHistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate operator session with legacy Urja Ops portal",
        "description": "Initiates SvelteKit form authentication, validates CSRF origin headers, and establishes a secure session cookie.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful and session cookie cached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid operator credentials"
          },
          "403": {
            "description": "CSRF Origin rejection by legacy portal"
          }
        }
      }
    },
    "/api/v1/auth/status": {
      "get": {
        "summary": "Check current cached session status",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Current session status"
          }
        }
      }
    }
  }
}